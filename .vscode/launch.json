{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sistema de Notificação (Flask)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/notificacao_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
